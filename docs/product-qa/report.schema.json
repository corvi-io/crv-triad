{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crv.local/schemas/product-qa-report.schema.json",
  "title": "CRV Product QA Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode",
    "run",
    "scope",
    "journeys",
    "screenshots",
    "access_checks",
    "findings",
    "scores",
    "verification",
    "decision"
  ],
  "properties": {
    "version": { "const": 1 },
    "mode": { "enum": ["feature", "full", "recheck"] },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "branch",
        "commit",
        "environment",
        "data_mode",
        "evaluator",
        "limitations"
      ],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 7 },
        "environment": { "type": "string", "minLength": 1 },
        "data_mode": { "type": "string", "minLength": 1 },
        "evaluator": { "type": "string", "minLength": 1 },
        "baseline": { "type": ["string", "null"] },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apps", "modules", "personas", "tenants", "out_of_scope"],
      "properties": {
        "initiative": { "type": ["string", "null"] },
        "apps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["site", "web", "api", "cross-app"] }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "personas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tenants": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "out_of_scope": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "apps",
          "module",
          "persona",
          "tenant",
          "kind",
          "name",
          "result",
          "evidence"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "apps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["site", "web", "api"] }
          },
          "module": { "type": "string", "minLength": 1 },
          "persona": { "type": "string", "minLength": 1 },
          "tenant": { "type": ["string", "null"] },
          "kind": {
            "enum": ["happy_path", "edge_case", "regression", "recheck"]
          },
          "name": { "type": "string", "minLength": 1 },
          "result": { "enum": ["passed", "failed", "blocked", "not_run"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "screenshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "journey_id",
          "checkpoint",
          "viewport",
          "artifact",
          "inspected",
          "result",
          "observations"
        ],
        "properties": {
          "journey_id": { "type": "string", "minLength": 1 },
          "checkpoint": { "type": "string", "minLength": 1 },
          "viewport": { "type": "string", "minLength": 1 },
          "artifact": { "type": "string", "minLength": 1 },
          "inspected": { "const": true },
          "result": { "enum": ["passed", "failed"] },
          "observations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "access_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor", "resource_tenant", "vector", "result", "evidence"],
        "properties": {
          "actor": { "type": "string", "minLength": 1 },
          "resource_tenant": { "type": ["string", "null"] },
          "vector": { "type": "string", "minLength": 1 },
          "result": { "enum": ["passed", "failed", "blocked", "not_run"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "severity",
          "app",
          "module",
          "title",
          "status",
          "evidence",
          "attempts"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "enum": [
              "product_defect",
              "test_defect",
              "environment_limitation",
              "documentation_gap",
              "accepted_deferral"
            ]
          },
          "severity": { "enum": ["blocker", "high", "medium", "low"] },
          "app": { "enum": ["site", "web", "api", "cross-app"] },
          "module": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["open", "fixed", "accepted", "not_reproduced", "blocked"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "attempts": { "type": "integer", "minimum": 0, "maximum": 3 }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_outcome",
        "functional_reliability_persistence",
        "ux_visual_integrity",
        "access_privacy_tenant_isolation",
        "accessibility",
        "operability_regression_protection",
        "weighted_total"
      ],
      "properties": {
        "product_outcome": { "$ref": "#/$defs/score" },
        "functional_reliability_persistence": { "$ref": "#/$defs/score" },
        "ux_visual_integrity": { "$ref": "#/$defs/score" },
        "access_privacy_tenant_isolation": { "$ref": "#/$defs/score" },
        "accessibility": { "$ref": "#/$defs/score" },
        "operability_regression_protection": { "$ref": "#/$defs/score" },
        "weighted_total": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "result", "evidence"],
        "properties": {
          "check": { "type": "string", "minLength": 1 },
          "result": { "enum": ["passed", "failed", "blocked", "skipped"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "decision": { "enum": ["approved", "approved_with_reservations", "not_approved"] }
  },
  "$defs": {
    "score": { "type": ["number", "null"], "minimum": 0, "maximum": 10 }
  }
}
