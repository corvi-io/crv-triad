{
  "name": "site",
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "astro dev --port 3004",
    "build": "astro build",
    "preview": "astro preview",
