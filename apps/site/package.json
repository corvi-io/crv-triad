    "astro": "7.1.3",
    "posthog-js": "^1.422.5",
    "sharp": "0.35.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "puppeteer": "^25.0.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.3"
