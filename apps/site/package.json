{
  "name": "site",
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "astro dev --port 3001",
    "build": "astro build",
    "preview": "astro preview",
    "start": "astro preview",
    "check": "biome check . && astro check",
    "format": "biome format --write .",
    "lighthouse:install": "puppeteer browsers install chrome",
    "lighthouse:report": "bun run build && bun run lighthouse:install && node ./scripts/generate-lighthouse-report.mjs",
    "lint": "biome lint .",
    "typecheck": "astro check",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/astro": "^1.28.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "puppeteer": "^25.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
