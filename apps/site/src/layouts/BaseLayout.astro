---
import "../styles/global.css"
import AnalyticsConsent from "../components/site/AnalyticsConsent.astro"

interface Props {
  title?: string
  description?: string
  noindex?: boolean
  bodyClass?: string
}

const {
  title = "CRV Triad",
  description = "Pagina institucional temporaria da CRV Triad.",
  noindex = false,
  bodyClass,
} = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://example.com")
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY || ""
const apiBaseUrl = (import.meta.env.PUBLIC_API_BASE_URL || "http://localhost:8000").replace(/\/$/, "")
const posthogHost = `${apiBaseUrl}/e`
const analyticsEnvironment = import.meta.env.PUBLIC_APP_ENV || "development"
---

<!doctype html>
<html lang="pt-BR" data-posthog-key={posthogKey} data-posthog-host={posthogHost} data-analytics-environment={analyticsEnvironment}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Ir para o conteúdo principal</a>
    <slot />
    <AnalyticsConsent />
    <script src="../scripts/analytics.ts"></script>
  </body>
</html>
