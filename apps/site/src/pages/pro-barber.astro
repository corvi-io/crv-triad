---
import BaseLayout from "../layouts/BaseLayout.astro"
import SolutionHero from "../components/site/SolutionHero.astro"
import FinalCta from "../components/site/FinalCta.astro"
import Faq from "../components/site/Faq.astro"
import Footer from "../components/site/Footer.astro"
import LeadDialog from "../components/site/LeadDialog.astro"
import Arrow from "../components/ui/Arrow.astro"
import "../styles/pages/pro-barber.css"
import "../styles/pages/pro-barber-extra.css"
const capabilities = [["Próximo atendimento", "Cliente, serviço, horário e tempo restante aparecem juntos para o barbeiro se preparar."], ["Agenda pessoal", "Visões de hoje, semana e mês organizam confirmados, atendidos e cancelamentos."], ["Produção e comissão", "O profissional acompanha o que produziu e a estimativa de comissão no mesmo resumo."], ["Contexto do cliente", "Serviço agendado, histórico e detalhes úteis acompanham cada atendimento."], ["Comunicados", "Avisos operacionais chegam dentro do ambiente de trabalho, com leitura confirmada."]]
---
<BaseLayout title="TRIAD Pro Barber | A rotina do barbeiro na palma da mão" description="Próximo atendimento, agenda pessoal, produção, comissões e comunicados conectados à operação da barbearia."><main id="main-content"><SolutionHero kind="TRIAD PRO BARBER" title="O trabalho do barbeiro, simplificado." body="O próximo cliente, a agenda e o resultado do dia em uma experiência feita para acompanhar o ritmo da cadeira." image="/figma/pro-barber/inicio-atual.png" device="phone" />
<section class="pb-intro"><div class="shell"><h2>Tudo o que importa agora.<br />Sem depender do balcão.</h2><p>O Pro Barber transforma a operação do Studio em uma visão pessoal: cada profissional encontra o que precisa para se preparar, atender e acompanhar o próprio resultado.</p></div></section>
<section class="pb-showcase"><div class="shell pb-showcase-grid"><div class="pb-phone"><img src="/figma/pro-barber/inicio.png" alt="Início do TRIAD Pro Barber com próximo atendimento, resumo do dia e agenda" width="390" height="844" /></div><div class="pb-story"><span>ANTES DO PRIMEIRO CORTE</span><h2>O dia começa com contexto.</h2><p>Ao abrir o Pro Barber, o profissional reconhece o ritmo do dia: quem é o próximo cliente, qual serviço será realizado e como a agenda está distribuída.</p><dl><div><dt>Próximo cliente</dt><dd>Horário, serviço e tempo restante em destaque.</dd></div><div><dt>Resumo do dia</dt><dd>Agendados, concluídos, produção e comissão em uma leitura rápida.</dd></div><div><dt>Sequência de atendimentos</dt><dd>A ordem do dia continua visível sem ruído operacional.</dd></div></dl></div></div></section>
<section class="pb-capabilities"><div class="shell"><h2>Uma visão própria, conectada à mesma operação.</h2><div class="pb-capability-list">{capabilities.map(([title,body]) => <article><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>
<section class="pb-showcase alternate"><div class="shell pb-showcase-grid"><div class="pb-phone"><img src="/figma/pro-barber/agenda.png" alt="Agenda do TRIAD Pro Barber com atendimentos e seus status" width="390" height="1194" /></div><div class="pb-story"><span>DURANTE O DIA</span><h2>A agenda acompanha o que muda.</h2><p>O profissional alterna entre hoje, semana e mês e entende o estado de cada atendimento sem precisar perguntar à recepção.</p><ul><li>Próximo atendimento destacado</li><li>Status confirmado, atendido ou cancelado</li><li>Horário previsto e alterações visíveis</li><li>Serviço e cliente no mesmo contexto</li></ul><a class="text-link" href="#comecar">Levar o Pro Barber para minha equipe <Arrow /></a></div></div></section>
<section class="pb-service-flow"><div class="shell"><div class="pb-service-heading"><span>NA CADEIRA</span><h2>O atendimento continua conectado até o resultado.</h2><p>O barbeiro inicia o atendimento, ajusta os serviços realizados e finaliza com total e comissão estimada no mesmo fluxo.</p></div><div class="pb-service-screens"><figure><div class="pb-bordered-phone"><img src="/figma/pro-barber/atendimento.png" alt="Atendimento em andamento no TRIAD Pro Barber" width="390" height="844" /></div><figcaption><b>Atender com o contexto aberto</b><span>Cliente, serviços, observações, total e comissão permanecem visíveis durante o atendimento.</span></figcaption></figure><figure><div class="pb-bordered-phone"><img src="/figma/pro-barber/adicionar-servicos.png" alt="Inclusão de serviços no atendimento do TRIAD Pro Barber" width="390" height="844" /></div><figcaption><b>Ajustar o que aconteceu na cadeira</b><span>Serviços adicionais entram no atendimento antes da finalização e seguem para o resultado.</span></figcaption></figure></div></div></section>
<section class="pb-connection"><div class="shell"><h2>Uma mudança entra uma vez.<br />Studio e Pro Barber seguem juntos.</h2><div><p><b>Recepção</b><span>Organiza agenda, chegada e alterações.</span></p><p><b>Barbeiro</b><span>Acompanha o dia e registra o atendimento.</span></p><p><b>Gestão</b><span>Recebe o resultado conectado à operação.</span></p></div></div></section>
<section class="pb-outcomes"><div class="shell"><div><h2>Mais autonomia para quem atende. Mais alinhamento para quem opera.</h2><p>Studio e Pro Barber compartilham a mesma informação. A recepção organiza, o barbeiro acompanha e cada mudança chega à pessoa certa.</p></div><div class="pb-outcome-lines"><p><b>Menos interrupções</b><span>O barbeiro consulta o próprio dia sem depender do balcão.</span></p><p><b>Mais preparação</b><span>Cliente, serviço e horário aparecem antes do atendimento.</span></p><p><b>Resultado transparente</b><span>Produção e comissão ficam ligadas ao trabalho realizado.</span></p><p><b>Equipe informada</b><span>Comunicados operacionais permanecem no contexto da barbearia.</span></p></div></div></section><FinalCta title="Coloque cada profissional no mesmo ritmo." body="Conecte a equipe à operação com o TRIAD Studio e o Pro Barber." /><Faq /><Footer /></main><LeadDialog /></BaseLayout>
