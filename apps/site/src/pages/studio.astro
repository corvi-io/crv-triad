---
import BaseLayout from "../layouts/BaseLayout.astro"
import SolutionHero from "../components/site/SolutionHero.astro"
import FinalCta from "../components/site/FinalCta.astro"
import Faq from "../components/site/Faq.astro"
import Footer from "../components/site/Footer.astro"
import LeadDialog from "../components/site/LeadDialog.astro"
import Arrow from "../components/ui/Arrow.astro"
import "../styles/pages/studio.css"
const capabilities = [["Agenda e capacidade", "Organize horários, profissionais, serviços e disponibilidade em uma visão comum."], ["Recepção e atendimento", "Acompanhe chegada, espera, execução e conclusão sem perder o contexto do cliente."], ["Clientes e recorrência", "Mantenha histórico e relacionamento acessíveis para atender com continuidade."], ["Caixa e comissões", "Conecte pagamento e comissão ao atendimento que gerou cada movimento."], ["Dashboard e relatórios", "Transforme o que aconteceu na operação em sinais claros para decidir."]]
---
<BaseLayout title="TRIAD Studio | Gestão conectada para barbearias" description="Agenda, clientes, atendimentos, caixa e relatórios em uma visão operacional para donos e recepção."><main id="main-content"><SolutionHero kind="TRIAD STUDIO" title="A operação inteira, pronta para ser gerida." body="Controle para o dono, clareza para a recepção e uma fonte comum de verdade para toda a barbearia." image="/screens/dashboard.png" />
<section class="st-intro"><div class="shell"><h2>Do primeiro horário ao fechamento, cada etapa conversa com a próxima.</h2><p>O Studio organiza a rotina sem separar agenda, atendimento e resultado em ferramentas diferentes. A informação entra uma vez e acompanha a operação.</p></div></section><section class="st-flow"><div class="shell"><p>Agendar</p><i></i><p>Receber</p><i></i><p>Atender</p><i></i><p>Cobrar</p><i></i><p>Analisar</p></div></section>
<section class="st-showcase"><div class="shell st-showcase-grid"><div class="st-copy"><span>ANTES DE ABRIR AS PORTAS</span><h2>A agenda mostra o ritmo do dia.</h2><p>Horários, profissionais e serviços aparecem na mesma visão para que a recepção organize capacidade e responda às mudanças sem improviso.</p><dl><div><dt>Disponibilidade real</dt><dd>Horários livres e ocupados no contexto de cada profissional.</dd></div><div><dt>Leitura operacional</dt><dd>Quem atende, qual serviço e o estado de cada compromisso.</dd></div><div><dt>Mudanças compartilhadas</dt><dd>A atualização chega a quem organiza e a quem atende.</dd></div></dl></div><figure class="st-screen"><img src="/screens/agenda.png" alt="Agenda operacional do TRIAD Studio" width="1440" height="900" /></figure></div></section>
<section class="st-capabilities"><div class="shell"><h2>Uma operação conectada em cada responsabilidade.</h2><div>{capabilities.map(([title,body]) => <article><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>
<section class="st-showcase alternate"><div class="shell st-showcase-grid"><div class="st-copy"><span>COM A BARBEARIA EM MOVIMENTO</span><h2>A recepção sabe onde cada atendimento está.</h2><p>Chegada, espera, execução e conclusão deixam de ser informações dispersas. A equipe acompanha o fluxo e age a partir do mesmo estado.</p><ul><li>Próximos atendimentos e atrasos visíveis</li><li>Status claros para recepção e equipe</li><li>Contexto do cliente preservado</li><li>Próximo passo fácil de reconhecer</li></ul><a class="text-link" href="#comecar">Organizar minha operação <Arrow /></a></div><figure class="st-screen"><img src="/screens/atendimentos.png" alt="Gestão de atendimentos do TRIAD Studio" width="1440" height="900" /></figure></div></section>
<section class="st-two-views"><div class="shell"><div class="st-two-heading"><h2>Cliente e caixa continuam ligados ao atendimento.</h2></div><div class="st-paired-screens"><figure><div><img src="/screens/clientes.png" alt="Gestão de clientes do TRIAD Studio" width="1440" height="900" /></div><figcaption><b>Relacionamento com continuidade</b><span>Histórico e contexto disponíveis para a próxima visita.</span></figcaption></figure></div></div></section>
<section class="st-decision"><div class="shell"><div class="st-copy"><span>PARA DECIDIR, NÃO APENAS REGISTRAR</span><h2>O resultado volta para a gestão.</h2><p>O dashboard e os relatórios transformam a rotina em sinais: ocupação, atendimentos, faturamento e pontos que pedem atenção.</p><div class="st-decision-lines"><p><b>Hoje</b><span>O que exige ação agora.</span></p><p><b>Período</b><span>O que mudou na operação.</span></p><p><b>Equipe</b><span>Onde existe capacidade ou atenção.</span></p></div></div><figure class="st-screen"><img src="/screens/relatorios.png" alt="Relatórios operacionais do TRIAD Studio" width="1440" height="900" /></figure></div></section>
<section class="st-outcomes"><div class="shell"><h2>Menos ferramentas separadas.<br />Mais continuidade na operação.</h2><div><p><b>Uma fonte comum</b><span>Dono, recepção e barbeiros trabalham a partir da mesma informação.</span></p><p><b>Menos retrabalho</b><span>O dado acompanha o fluxo sem precisar ser digitado novamente.</span></p><p><b>Decisão com contexto</b><span>O resultado permanece ligado ao que aconteceu no atendimento.</span></p></div></div></section><FinalCta title="Assuma o controle da operação." body="Configure o essencial, organize a equipe e acompanhe o primeiro dia no TRIAD Studio." /><Faq /><Footer /></main><LeadDialog /></BaseLayout>
