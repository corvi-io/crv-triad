{
  "name": "studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_DEPLOY_TARGET=local VITE_SCHEDULING_SOURCE=memory vite --port 3000",
    "build": "bun run routes:generate && tsc -b && vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "routes:generate": "tsr generate",
    "check": "bun run routes:generate && biome check . && bun run typecheck && bun run test && bun run test:production-boundary",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "bun run routes:generate && tsc -b",
    "test": "bun run routes:generate && vitest run",
    "test:production-boundary": "VITE_DEPLOY_TARGET=prd VITE_SCHEDULING_SOURCE=disabled bun run build && bun ./scripts/assert-production-boundary.ts",
    "test:e2e": "playwright test",
    "test:e2e:sandbox": "playwright test tests/e2e/sandbox.spec.ts",
    "test:e2e:production": "VITE_DEPLOY_TARGET=prd VITE_SCHEDULING_SOURCE=disabled bun run build && playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.4.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "shadcn": "^4.14.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tunnel-rat": "^0.1.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.21",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
