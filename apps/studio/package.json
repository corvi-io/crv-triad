{
  "name": "studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "bun run routes:generate && tsc -b && vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "routes:generate": "tsr generate",
    "check": "bun run routes:generate && biome check . && bun run typecheck && bun run test && bun run test:production-boundary",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "bun run routes:generate && tsc -b",
    "test": "bun run routes:generate && vitest run",
    "test:production-boundary": "VITE_DEPLOY_TARGET=prd VITE_SCHEDULING_SOURCE=http VITE_BARBERSHOP_SETUP_SOURCE=http VITE_CLIENT_MANAGEMENT_SOURCE=http VITE_REVENUE_OPERATIONS_SOURCE=http bun run build && bun ./scripts/assert-production-boundary.ts",
    "test:e2e": "playwright test",
    "test:e2e:sandbox": "playwright test tests/e2e/sandbox.spec.ts",
    "test:e2e:production": "VITE_DEPLOY_TARGET=prd VITE_SCHEDULING_SOURCE=http VITE_BARBERSHOP_SETUP_SOURCE=http VITE_CLIENT_MANAGEMENT_SOURCE=http VITE_SERVICE_DESK_SOURCE=http VITE_REVENUE_OPERATIONS_SOURCE=http bun run build && playwright test --config playwright.production.config.ts",
    "test:coverage": "bun run routes:generate && vitest run --coverage",
    "coverage:check": "bun run routes:generate && vitest run --coverage --testTimeout=20000 --coverage.thresholds.statements=80 --coverage.thresholds.branches=80 --coverage.thresholds.functions=80 --coverage.thresholds.lines=80"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-router-devtools": "^1.167.1",
    "better-auth": "1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.43.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.87.0",
    "recharts": "3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tunnel-rat": "^0.1.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/router-cli": "^1.167.34",
    "@tanstack/router-plugin": "^1.168.36",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
