NODE_ENV=development
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=postgresql://triad_user:triad_password@127.0.0.1:5432/triad_database
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8000
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_SESSION_EXPIRES_IN_SECONDS=2592000
AUTH_PASSWORD_MIN_LENGTH=15
AUTH_PASSWORD_MAX_LENGTH=256
AUTH_RESET_PASSWORD_TOKEN_EXPIRES_IN_SECONDS=3600
AUTH_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
IDP_EMAIL_FROM=auth@example.invalid
IDP_STUDIO_URL=http://localhost:3000
IDP_RESEND_API_KEY=replace-with-resend-api-key
IDP_RESEND_API_URL=https://api.resend.com
LEAD_EMAIL_FROM=leads@example.invalid
LEAD_EMAIL_TO=contato@example.invalid,comercial@example.invalid
LEAD_RESEND_API_KEY=replace-with-resend-api-key
LEAD_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
LEAD_TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
LEAD_TURNSTILE_HOSTNAMES=localhost
LEAD_HOURLY_LIMIT=5
LEAD_DAILY_LIMIT=20
POSTHOG_UPSTREAM_URL=https://us.i.posthog.com
POSTHOG_PROJECT_KEY=phc_replace-with-public-project-key
