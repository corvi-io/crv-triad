{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "infisical run --silent --env=dev --path=/api -- bun scripts/dev.ts",
    "dev:local": "concurrently --kill-others-on-fail --names api,trigger --prefix-colors blue,magenta \"bun run dev:api\" \"bun run dev:trigger\"",
    "dev:api": "bun --watch src/server.ts",
    "dev:trigger": "trigger dev",
    "deploy:trigger": "trigger deploy",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun dist/server.js",
    "check": "biome check . && bun run typecheck && bun run test",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:coverage": "vitest run --coverage",
    "coverage:check": "vitest run --coverage --coverage.thresholds.statements=80 --coverage.thresholds.branches=80 --coverage.thresholds.functions=80 --coverage.thresholds.lines=80",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun src/modules/idp/database/migrate.ts",
    "bootstrap:admin": "bun src/modules/idp/scripts/bootstrap-admin.ts",
    "bootstrap:tenant": "bun src/modules/tenancy/scripts/bootstrap-tenant.ts",
    "bootstrap:backstage-owner": "bun src/modules/backstage/scripts/bootstrap-backstage-owner.ts",
    "configure:tenant-access": "bun src/modules/access/scripts/configure-tenant-access.ts",
    "recover:tenant-owner": "bun src/modules/access/scripts/recover-tenant-owner.ts",
    "email:preview": "email dev --dir src/modules/idp/identity/emails"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@elysiajs/openapi": "^1.4.16",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@trigger.dev/sdk": "4.5.16",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "better-auth": "1.7.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "uuid": "^14.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@trigger.dev/build": "4.5.16",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "5.0.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "trigger.dev": "4.5.16",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
