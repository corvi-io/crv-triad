{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn --app-dir src entrypoints.rest.main:app --reload --port 8000",
    "db:migrate": "uv run alembic upgrade head",
    "db:revision": "uv run alembic revision --autogenerate",
    "build": "uv run python -m compileall -q src && mkdir -p dist && touch dist/.build",
    "start": "uv run uvicorn --app-dir src entrypoints.rest.main:app",
    "check": "bun run format:check && bun run lint:check && bun run test",
    "format": "uv run ruff format .",
    "format:check": "uv run ruff format --check .",
    "lint": "uv run ruff check . --fix && uv run ruff format .",
    "lint:check": "uv run ruff check .",
    "test": "uv run pytest",
    "test:coverage": "uv run pytest --cov=src --cov-report=term-missing --cov-report=xml",
    "coverage:check": "uv run pytest --cov=src --cov-report=term-missing --cov-fail-under=80",
    "typecheck": "uv run python -m compileall -q src tests"
  }
}
