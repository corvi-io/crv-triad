NODE_ENV=development
APP_ENV=local
IDP_HOST=127.0.0.1
IDP_PORT=8001
DATABASE_URL=postgresql://idp_user:idp_password@127.0.0.1:5432/idp_database
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8001
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_SESSION_EXPIRES_IN_SECONDS=2592000
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=256
AUTH_RESET_PASSWORD_TOKEN_EXPIRES_IN_SECONDS=3600
IDP_INVITATION_EMAILS_ENABLED=false
IDP_INVITATION_EMAIL_FROM=
IDP_INVITATION_APP_URL=http://localhost:3000
IDP_RESEND_API_KEY=
IDP_RESEND_API_URL=https://api.resend.com
