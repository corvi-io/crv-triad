{
  "name": "idp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "bun dist/server.js",
    "check": "biome check . && bun run typecheck && bun run test",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun src/database/migrate.ts",
    "bootstrap:admin": "bun src/scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.11",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.11",
    "pg": "^8.22.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
